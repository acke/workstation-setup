#!/usr/bin/env bash
# Sync skills-and-agents into ~/.claude and ~/.cursor as symlinks.
# Skills and agents are only linked if no target with that name already exists.
# Re-run safely; idempotent.
#
# Layout:
#   skills/<name>/SKILL.md   -> ~/.claude/skills/<name> + ~/.cursor/skills/<name>
#   agents/<name>.md         -> ~/.claude/agents/<name>.md
#   workflows/<name>.js      -> ~/.claude/workflows/<name>.js
#   hooks/<name>.sh|.py      -> ~/.claude/hooks/<name>
#
# Env:
#   SKILLS_AND_AGENTS_REPO    path to clone (default: ~/repos/skills-and-agents)
#   SKILLS_AND_AGENTS_PULL=0  skip the git pull step (default: 1 = pull)
#   SKILLS_AND_AGENTS_VERBOSE=1  log every link/skip

set -u

REPO="${SKILLS_AND_AGENTS_REPO:-$HOME/repos/skills-and-agents}"
CLAUDE_SKILLS="$HOME/.claude/skills"
CURSOR_SKILLS="$HOME/.cursor/skills"
CLAUDE_AGENTS="$HOME/.claude/agents"
CLAUDE_WORKFLOWS="$HOME/.claude/workflows"
CLAUDE_HOOKS="$HOME/.claude/hooks"

VERBOSE="${SKILLS_AND_AGENTS_VERBOSE:-0}"
LINKED=0
SKIPPED=0

log()  { [ "$VERBOSE" = "1" ] && printf '%s\n' "$*" >&2; return 0; }
warn() { printf 'skills-and-agents-sync: %s\n' "$*" >&2; }

[ -d "$REPO" ] || { warn "missing $REPO"; exit 0; }

if [ "${SKILLS_AND_AGENTS_PULL:-1}" = "1" ] && [ -e "$REPO/.git" ]; then
  if git -C "$REPO" pull --ff-only --quiet 2>/dev/null; then
    log "pulled latest in $REPO"
  else
    log "pull skipped or failed in $REPO (offline, dirty tree, or non-ff)"
  fi
fi

mkdir -p "$CLAUDE_SKILLS" "$CURSOR_SKILLS" "$CLAUDE_AGENTS" "$CLAUDE_WORKFLOWS" "$CLAUDE_HOOKS"

link_one() {
  local src="$1" dst="$2"
  if [ -L "$dst" ]; then
    if [ "$(readlink "$dst")" = "$src" ]; then
      log "ok:    $dst"
      return 0
    fi
    log "skip:  $dst (other symlink)"
    SKIPPED=$((SKIPPED + 1))
    return 0
  fi
  if [ -e "$dst" ]; then
    log "skip:  $dst (real file/dir)"
    SKIPPED=$((SKIPPED + 1))
    return 0
  fi
  ln -s "$src" "$dst"
  LINKED=$((LINKED + 1))
  log "link:  $dst -> $src"
}

# Skills (Claude + Cursor)
if [ -d "$REPO/skills" ]; then
  for d in "$REPO/skills"/*/; do
    [ -d "$d" ] || continue
    [ -f "${d}SKILL.md" ] || continue
    name="$(basename "$d")"
    src="${d%/}"
    link_one "$src" "$CLAUDE_SKILLS/$name"
    link_one "$src" "$CURSOR_SKILLS/$name"
  done
fi

# Agents (Claude only)
if [ -d "$REPO/agents" ]; then
  for f in "$REPO/agents"/*.md; do
    [ -f "$f" ] || continue
    name="$(basename "$f")"
    link_one "$f" "$CLAUDE_AGENTS/$name"
  done
fi

# Workflows (Claude only)
if [ -d "$REPO/workflows" ]; then
  for f in "$REPO/workflows"/*; do
    [ -f "$f" ] || continue
    name="$(basename "$f")"
    link_one "$f" "$CLAUDE_WORKFLOWS/$name"
  done
fi

# Hooks (Claude only)
if [ -d "$REPO/hooks" ]; then
  for f in "$REPO/hooks"/*.sh "$REPO/hooks"/*.py; do
    [ -f "$f" ] || continue
    name="$(basename "$f")"
    link_one "$f" "$CLAUDE_HOOKS/$name"
  done
fi

printf 'skills-and-agents-sync: linked=%d skipped=%d\n' "$LINKED" "$SKIPPED" >&2
exit 0
