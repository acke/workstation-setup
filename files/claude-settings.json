{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(claude stop *)",
      "Bash(claude rm *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git tag:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(jq:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(xargs:*)",
      "Bash(which:*)",
      "Bash(npm:*)",
      "Bash(make:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(bun:*)",
      "Bash(pip:*)",
      "Bash(cargo:*)",
      "Bash(go:*)",
      "Bash(tee:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(true)",
      "Bash(false)",
      "Bash(test:*)",
      "Bash(/usr/bin/grep:*)",
      "Bash(/usr/bin/find:*)",
      "Bash(/usr/bin/sed:*)",
      "Bash(/usr/bin/awk:*)",
      "Bash(/bin/cat:*)",
      "Bash(/bin/ls:*)",
      "Bash(/usr/bin/head:*)",
      "Bash(/usr/bin/tail:*)",
      "mcp__claude_ai_Gmail__get_message",
      "mcp__claude_ai_Gmail__get_thread",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__list_drafts",
      "mcp__claude_ai_Gmail__get_draft",
      "mcp__claude_ai_Gmail__list_labels",
      "mcp__claude_ai_Google_Calendar__list_calendars",
      "mcp__claude_ai_Google_Calendar__list_events",
      "mcp__claude_ai_Google_Calendar__get_event",
      "mcp__claude_ai_Google_Calendar__search_events",
      "mcp__claude_ai_Google_Calendar__suggest_time",
      "mcp__claude_ai_Google_Drive__get_file_metadata",
      "mcp__claude_ai_Google_Drive__get_file_permissions",
      "mcp__claude_ai_Google_Drive__list_recent_files",
      "mcp__claude_ai_Google_Drive__read_file_content",
      "mcp__claude_ai_Google_Drive__search_files",
      "mcp__claude_ai_Google_Drive__download_file_content",
      "Skill(code-review)"
    ],
    "deny": [
      "Bash(rm -rf /)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/skipper/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/skipper/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/skipper/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/post-push-reflect-trigger.sh",
            "timeout": 5,
            "statusMessage": "Queuing reflect after push...",
            "asyncRewake": true,
            "rewakeMessage": "A git push just completed. Please invoke the /reflect skill now to capture learnings from this session.",
            "rewakeSummary": "git push done — invoking /reflect"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/usage-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking usage window"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-push.sh",
            "if": "Bash(git push*)",
            "timeout": 600,
            "statusMessage": "Running make pre-push"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/block-no-verify.sh",
            "timeout": 5,
            "statusMessage": "Checking for bypass flags..."
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/block-gh-admin.sh",
            "timeout": 5,
            "statusMessage": "Checking for --admin flag..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/skipper/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/skipper/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$HOME/.claude/brain\" pull --rebase --autostash --quiet origin main >/dev/null 2>&1 || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-start-load-unslop.sh\"",
            "timeout": 5,
            "statusMessage": "Loading unslop skill..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/skipper/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/no-deflection.py",
            "timeout": 10,
            "statusMessage": "Checking for deflection..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/skipper/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/skipper/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/skipper/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/warn-no-test-evidence.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/skipper/.config/iterm2/cc-status"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/hooks/statusline-tee.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "jev-rust-review@jev-rust-review": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typesafe@typesafe-ai": true,
    "ribbon@robonuggets": true,
    "neo4j-skills@neo4j-skills-marketplace": true,
    "warp@claude-code-warp": true,
    "linear-pack@claude-code-plugins-plus": true,
    "cli-ux-tester@claude-code-plugins-plus": true,
    "contract-test-validator@claude-code-plugins-plus": true,
    "api-fuzzer@claude-code-plugins-plus": true,
    "api-test-automation@claude-code-plugins-plus": true,
    "code-cleanup@claude-code-plugins-plus": true
  },
  "extraKnownMarketplaces": {
    "jev-rust-review": {
      "source": {
        "source": "github",
        "repo": "kindintelligence/jev-rust-review"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    },
    "robonuggets": {
      "source": {
        "source": "github",
        "repo": "robonuggets/ribbon"
      }
    },
    "neo4j-skills-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/neo4j-contrib/neo4j-skills.git"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "claude-code-plugins-plus": {
      "source": {
        "source": "github",
        "repo": "jeremylongshore/claude-code-plugins"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "proxy.golang.org",
        "sum.golang.org",
        "golang.org",
        "go.dev",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "static.crates.io",
        "index.crates.io",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com"
      ],
      "allowUnixSockets": [
        "/var/run/docker.sock"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/Library/Caches",
        "~/.local/share",
        "~/.local/state",
        "~/go",
        "~/.cargo/registry",
        "~/.cargo/git",
        "~/.npm",
        "~/.yarn",
        "~/.pnpm-store",
        "~/.bun",
        "~/.asdf/installs",
        "~/.asdf/shims",
        "~/.asdf/plugins",
        "~/.claude/brain"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gh/hosts.yml",
        "~/.zsh_history",
        "~/.bash_history",
        "~/.npmrc",
        "~/.yarnrc",
        "~/.yarnrc.yml",
        "~/.pypirc",
        "~/.netrc",
        "~/.docker/config.json",
        "~/.kube/config",
        "~/.cargo/credentials.toml",
        "~/Library/Application Support/Google/Chrome",
        "~/Library/Application Support/Firefox",
        "~/Library/Cookies",
        "~/Library/Keychains",
        "~/Library/Mail",
        "~/Library/Messages"
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "git",
      "gh",
      "bd",
      "gt"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true
  },
  "theme": "auto",
  "editorMode": "vim",
  "preferredNotifChannel": "iterm2_with_bell",
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "TEMPORARY, valid only on 2026-10-04: the user pre-authorized code reviews of open mackaby/talva-platform PRs, including running the code-review skill \n  and posting the findings as plain PR comments (`gh pr comment`). This does not cover formal GitHub reviews (`gh pr review \n  --approve/--request-changes`), merges, or pushes."
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: Not queryable here (no origin remote in this repo — ~/knut has zero tracked files and no remotes); assume private",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: Not queryable here (no origin remote, default branch unknown)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: The current directory (~/knut) has no tracked files and no remotes configured — no source control context established",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured — the bucket names found in repo-wide config scans (bucket, bucket_name, my-bucket, mybucket, etc.) are generic placeholder/example names from documentation and skill templates, not usage-corroborated upload destinations",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development, plus product-management / GTM / customer-success / people-ops document generation via a personal skills library (CLAUDE.md agents & skills for PRDs, sprint planning, launch plans, 401k/accommodation/accessibility guides)",
      "**Trusted repo**: The working directory ~/knut has no tracked files and no configured git remotes — no trusted repo established here; treat any writes as local-only until a remote is added",
      "**Org-specific CLIs**: None configured — frequently used personal CLIs observed in shell history include gog, hermes, z, hx, lg, openclaw, tailscale, lazygit (none org-specific)",
      "**Routine under acke/ prefix**: the user's own GitHub repos observed (acke/hermes-backup, acke/hermes-agent, acke/watchtower-kb, acke/talva-docs, acke/jobs-tracker, acke/genforeningen, acke/agent-factory-specs, acke/pr-status-monitor, acke/goal-forge, acke/brain, acke/workstation-setup, acke/talva-doc-skills) are candidate personal-repo context but unverified for this session since scope is just this project"
    ]
  }
}
