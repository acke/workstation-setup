# =============================================================================
# Homebrew & shell
# =============================================================================
eval "$(/opt/homebrew/bin/brew shellenv)"
export PATH="/usr/local/bin:$PATH"
export SHELL="$(command -v zsh)"

# =============================================================================
# Oh My Zsh — https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
# =============================================================================
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

plugins=(
  aliases
  autojump
  colorize
  dircycle
  git
  history
  screen
  zoxide
)

source "$ZSH/oh-my-zsh.sh"

# zsh-autosuggestions (installed via Homebrew)
[[ -f "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && \
  source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# =============================================================================
# History
# =============================================================================
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=1000000000
export SAVEHIST=1000000000
setopt EXTENDED_HISTORY

# =============================================================================
# Node: nvm
# =============================================================================
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

# =============================================================================
# Go
# =============================================================================
unset GOROOT
[ -d "/opt/homebrew/opt/go/libexec" ] && export GOROOT="/opt/homebrew/opt/go/libexec"
export GOPATH="${GOPATH:-$HOME/go}"
export PATH="$PATH:$GOPATH/bin"

# =============================================================================
# PATH — tools & CLIs (order: project tools → user → npm → apps)
# =============================================================================
# Do not use $(npm config get prefix) here — it runs npm/node on every login and
# triggers macOS privacy prompts. Homebrew shellenv already puts global bins on PATH.
export PATH="$HOME/.local/bin:$PATH"

# =============================================================================
# Aliases
# =============================================================================
alias battery='pmset -g batt'
alias branch='git branch'
alias ta='tmux attach -t'
alias tl='tmux ls'
alias tn='tmux new-session -s'

# ============================================================                                                                                                                                                                                                                                                                                                                                                                                                                                           =================
# Other profiles
# =============================================================================
[ -f ~/.bash_profile ] && . ~/.bash_profile

# =============================================================================
# fzf & mcfly
# =============================================================================
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
eval "$(mcfly init zsh)"

# =============================================================================
# asdf version manager
# =============================================================================
[[ -f "$(brew --prefix asdf)/libexec/asdf.sh" ]] && source "$(brew --prefix asdf)/libexec/asdf.sh"

# =============================================================================
# GPG
# =============================================================================
export GPG_TTY="$(tty)"

# =============================================================================
# Local overrides (e.g. sdkman in ~/.zshrc.local)
# =============================================================================
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
export PATH="$HOME/repos/workstation-setup/scripts/custom/sync:$PATH"

# =============================================================================
# Daily sync — runs once per calendar day (first shell start only).
# Force a re-run any time: touch -t 000101010000 ~/.cache/daily-sync-stamp
# =============================================================================
_SYNC_STAMP="$HOME/.cache/daily-sync-stamp"
if [[ "$(cat "$_SYNC_STAMP" 2>/dev/null)" != "$(date +%Y-%m-%d)" ]]; then
  SYNC_DIR="$HOME/repos/workstation-setup/scripts/custom/sync"
  [ -x "$SYNC_DIR/ide-tools-sync" ]            && "$SYNC_DIR/ide-tools-sync"
  [ -x "$SYNC_DIR/bastis-harness-sync" ]       && "$SYNC_DIR/bastis-harness-sync"
  [ -x "$SYNC_DIR/external-skills-sync" ]      && "$SYNC_DIR/external-skills-sync"
  [ -x "$SYNC_DIR/claude-marketplaces-sync" ]  && "$SYNC_DIR/claude-marketplaces-sync"
  [ -x "$SYNC_DIR/bastis-dev-container-sync" ] && "$SYNC_DIR/bastis-dev-container-sync"
  [ -x "$SYNC_DIR/skills-and-agents-sync" ]   && "$SYNC_DIR/skills-and-agents-sync"
  date +%Y-%m-%d > "$_SYNC_STAMP"
  unset SYNC_DIR
fi
unset _SYNC_STAMP

# OSC 133 prompt marker — lets terminals jump between prompts in scrollback.
_osc133_prompt_start() { print -Pn '\e]133;A\e\\' }
precmd_functions+=(_osc133_prompt_start)

# =============================================================================
# Line-editing keybindings — needed inside tmux where Warp's editor doesn't apply.
# In Warp, rebind: Cmd+Backspace -> ^U, Cmd+Left -> ^A, Cmd+Right -> ^E,
#                  Opt+Backspace -> ^[^?, Opt+Left -> ^[b, Opt+Right -> ^[f.
# =============================================================================
bindkey "^[^?" backward-kill-word     # Opt+Backspace: delete word left
bindkey "^W"   backward-kill-word     # Ctrl+W
bindkey "^U"   backward-kill-line     # Ctrl+U / Cmd+Backspace: delete to line start
bindkey "^[b"  backward-word          # Opt+Left
bindkey "^[f"  forward-word           # Opt+Right
bindkey "^A"   beginning-of-line      # Ctrl+A / Cmd+Left
bindkey "^E"   end-of-line            # Ctrl+E / Cmd+Right
